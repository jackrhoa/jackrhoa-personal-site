{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jackrhoa-switcher-emulator-site",
  "account_id": "59bb44f2e2fbd89a6c9ef05e9e168132",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-02",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "jackrhoa.com", "custom_domain": true },
    { "pattern": "www.jackrhoa.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "UNLOCKS_DB",
      "database_name": "jackrhoa-unlocks",
      "database_id": "333f8b74-f1d1-4092-b798-42470f533cba",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
